        request.resource.data.get('senderId', '') == request.auth.uid ||
        isSupportAgent()
      );
      allow get, list: if isSignedIn();
      allow update, delete: if isSupportAgent();
    }


    // =========================================================================
    // SECTION 19: LIVE STREAMING, AUDIO ROOMS & VOICE NOTES
    // =========================================================================

    // Live Video Streams (/live_streams/{streamId})
    match /live_streams/{streamId} {
      allow create: if isSignedIn() && (
        request.resource.data.get('streamerId', '') == request.auth.uid ||
        isAdmin()
      );
      allow get, list: if isSignedIn();
      allow update: if isSignedIn() && (
        resource == null ||
        resource.data.get('streamerId', '') == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'likes', 'status', 'endedAt', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource == null ||
        resource.data.get('streamerId', '') == request.auth.uid ||
        isAdmin()
      );

      match /comments/{commentId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn();
      }

      match /viewers/{viewerId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      match /tips/{tipId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isAdmin();
      }
    }

    // Live Audio Drop-In Rooms (/audio_rooms/{roomId})
    match /audio_rooms/{roomId} {
      allow create: if isSignedIn() && (
        request.resource.data.get('hostId', '') == request.auth.uid ||
        isAdmin()
      );
      allow get, list: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (
        resource == null ||
        resource.data.get('hostId', '') == request.auth.uid ||
        isAdmin()
      );

      match /participants/{participantId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }

      match /messages/{messageId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow delete: if isSignedIn();
      }

      match /speakers/{speakerId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSignedIn();
      }
    }

    // Voice Notes & Audio Memos (/voice_notes/{noteId})
    match /voice_notes/{noteId} {
      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('senderId', '') == request.auth.uid ||
        isAdmin()
      );
      allow get, list: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource == null ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('senderId', '') == request.auth.uid ||
        isAdmin()
      );
    }


    // =========================================================================
    // SECTION 20: SYSTEM CONFIG, TELEMETRY, FEATURE FLAGS & LOGS (ADMIN SECURED)
    // =========================================================================

    // Global Broadcast Announcements (/announcements/{announcementId})
    match /announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Dynamic Remote Application Config (/appConfig/{configId})
    match /appConfig/{configId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Dynamic Feature Flags (/featureFlags/{flagId})
    match /featureFlags/{flagId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // System Maintenance State (/maintenance/{maintenanceId})
    match /maintenance/{maintenanceId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Beta Features Access Control (/betaFeatures/{featureId})
    match /betaFeatures/{featureId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Experimental Alpha Flags (/experimentalFeatures/{featureId})
    match /experimentalFeatures/{featureId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // A/B Testing Experiments (/abTesting/{testId})
    match /abTesting/{testId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Client Error Crash Reports (/errorLogs/{logId})
    match /errorLogs/{logId} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Client Diagnostic Debug Logs (/debugLogs/{logId})
    match /debugLogs/{logId} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Performance Metrics & Profiling (/performanceMetrics/{metricId})
    match /performanceMetrics/{metricId} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // API Rate & Quota Logs (/apiUsageLogs/{logId})
    match /apiUsageLogs/{logId} {
      allow create: if isSignedIn();
      allow get, list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // System Stats & Aggregate Counters (/systemStats/{statId})
    match /systemStats/{statId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Feature Engagement Statistics (/featureUsageStats/{statId})
    match /featureUsageStats/{statId} {
      allow create, update: if isSignedIn();
      allow get, list: if isAdmin();
      allow delete: if isAdmin();
    }

    // Database Migration Logs (/migrationLogs/{migrationId})
    match /migrationLogs/{migrationId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Backup & Snapshot Metadata (/backupMetadata/{backupId})
    match /backupMetadata/{backupId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Unified System Log Repository (/systemLogs/{logId})
    match /systemLogs/{logId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Global Leaderboard Registry (/leaderboards/{leaderboardId})
    match /leaderboards/{leaderboardId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }


    // =========================================================================
    // SECTION 20B: ADMIN DASHBOARD, DEFENDER, FIREWALL & SYSTEM REMOTE CONFIG
    // =========================================================================

    // Master System Remote Feature Flags & Maintenance Mode (/system_config/{configId})
    match /system_config/{configId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Admin Dashboard Aggregates & Console Data (/admin_dashboard/{docId})
    match /admin_dashboard/{docId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Network Firewall Rules & Access Control Lists (/firewall_rules/{ruleId})
    match /firewall_rules/{ruleId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Network Blocked IP Addresses (/blocked_ips/{ipId})
    match /blocked_ips/{ipId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Defender Security Scans & Threat Analysis (/defender_scans/{scanId})
    match /defender_scans/{scanId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Defender Threat Definition Updates (/defender_definitions/{defId})
    match /defender_definitions/{defId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Platform Security & Administrative Audit Logs (/admin_audit_logs/{logId})
    match /admin_audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Administrative Actions & Remote Command Queue (/admin_actions/{actionId})
    match /admin_actions/{actionId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // System-Wide Emergency Announcements & Alerts (/system_alerts/{alertId})
    match /system_alerts/{alertId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Role-Based Access Control Registry (/user_roles/{uid})
    match /user_roles/{uid} {
      allow get: if isOwnerOrAdmin(uid);
      allow list: if isAdmin();
      allow create, update, delete: if isSuperAdmin() || isAdmin();
    }


    // =========================================================================
    // SECTION 20C: MAD LIMITLESS LEVELING, MISSIONS, SCI-FI & TOKEN CASHOUTS
    // =========================================================================

    // Limitless Leveling & XP Telemetry (/user_leveling/{uid})
    match /user_leveling/{uid} {
      allow get, list: if isSignedIn();
      allow create: if isOwnerOrAdmin(uid);
      allow update: if isOwnerOrAdmin(uid);
      allow delete: if isAdmin();
    }

    // Operative Daily Quests & Mission Progression (/user_quests/{uid})
    match /user_quests/{uid} {
      allow get, list: if isOwnerOrAdmin(uid);
      allow create, update: if isOwnerOrAdmin(uid);
      allow delete: if isAdmin();
    }

    // Global Operative Quest Catalog (/operative_quests/{questId})
    match /operative_quests/{questId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Token Cashout & Selling Transactions (/token_cashouts/{cashoutId})
    match /token_cashouts/{cashoutId} {
      allow get, list: if isSignedIn() && (
        resource == null ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('user_id', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        request.resource.data.get('user_id', '') == request.auth.uid ||
        isAdmin()
      );
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource != null &&
        resource.data.get('userId', '') == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'cancelledAt', 'status'])
      );
      allow delete: if isAdmin();
    }

    // Sci-Fi Animations Multi-Screen Equipped Map (/scifi_equipped/{uid})
    match /scifi_equipped/{uid} {
      allow get, list: if isSignedIn();
      allow create, update: if isOwnerOrAdmin(uid);
      allow delete: if isAdmin();
    }

    // Sci-Fi Animation Purchases Registry (/scifi_purchases/{purchaseId})
    match /scifi_purchases/{purchaseId} {
      allow get, list: if isSignedIn() && (
        resource == null ||
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && (
        request.resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // Gaming Arena & Clan Battles (/clan_battles/{battleId})
    match /clan_battles/{battleId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }


    // =========================================================================
    // SECTION 21: RECURSIVE COLLECTION GROUP RULES (collectionGroup queries)
    // =========================================================================

    // Messages collection group
    match /{path=**}/messages/{messageId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.get('senderId', '') == request.auth.uid ||
        request.resource.data.get('sender_id', '') == request.auth.uid ||
        isAdmin()
      );
      allow update: if isSignedIn() && (
        resource == null ||
        resource.data.get('senderId', '') == request.auth.uid ||
        resource.data.get('sender_id', '') == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource == null ||
        resource.data.get('senderId', '') == request.auth.uid ||
        resource.data.get('sender_id', '') == request.auth.uid ||
        isAdmin()
      );
    }

    // Events collection group
    match /{path=**}/events/{eventId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Participants collection group
    match /{path=**}/participants/{participantId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Tokens collection group
    match /{path=**}/tokens/{tokenId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Scores collection group
    match /{path=**}/scores/{scoreId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Comments collection group
    match /{path=**}/comments/{commentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource == null ||
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('authorId', '') == request.auth.uid ||
        isAdmin()
      );
    }

    // Likes collection group
    match /{path=**}/likes/{likeId} {
      allow get, list: if isSignedIn();
      allow create, delete: if isSignedIn();
    }

    // Offers collection group
    match /{path=**}/offers/{offerId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // Career History collection group
    match /{path=**}/history/{historyId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }


    // =========================================================================
    // SECTION 22: SECURITY FALLBACK (DEFAULT DENY UNLISTED PATHS)
    // =========================================================================

    // Explicitly deny read and write access to all undefined or unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
