        resource.data.get('sellerId', '') == request.auth.uid ||
        resource.data.get('buyer_id', '') == request.auth.uid ||
        resource.data.get('seller_id', '') == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if isSignedIn() && (
        resource == null ||
        resource.data.get('buyerId', '') == request.auth.uid ||
        resource.data.get('sellerId', '') == request.auth.uid ||
        resource.data.get('buyer_id', '') == request.auth.uid ||
        resource.data.get('seller_id', '') == request.auth.uid ||
        isAdmin()
