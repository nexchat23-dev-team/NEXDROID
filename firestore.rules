    // =========================================================================
    // SECTION 13: MARKETPLACE & IN-APP TRADING
    // =========================================================================

    function isListingSeller(listingData) {
      return isSignedIn() && (
        listingData.get('sellerId', '') == request.auth.uid ||
        listingData.get('seller_id', '') == request.auth.uid ||
        listingData.get('sellerUID', '') == request.auth.uid ||
        isAdmin()
      );
    }

    // Marketplace Listings (/marketplace/{listingId})
    match /marketplace/{listingId} {
      allow create: if isSignedIn() && (
        request.resource.data.get('sellerId', '') == request.auth.uid ||
        request.resource.data.get('seller_id', '') == request.auth.uid ||
        isAdmin()
      );
      allow get, list: if isSignedIn();
      allow update: if isSignedIn() && (
        resource == null ||
        isListingSeller(resource.data) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'inquiries', 'offersCount', 'updatedAt']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource == null ||
        isListingSeller(resource.data) ||
        isAdmin()
      );

      // Subcollection Offers
      match /offers/{offerId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn();
      }

      // Subcollection Reviews & Ratings
      match /reviews/{reviewId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn();
      }
    }

    // Flat Marketplace Offers (/marketplaceOffers/{offerId})
